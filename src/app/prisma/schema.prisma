generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Investigation {
  id           String              @id @default(cuid())
  tenantId     String              @map("tenant_id")
  cluster      String
  incidentId   String              @map("incident_id")
  model        String
  effort       String?
  systemPrompt String              @map("system_prompt")
  status       InvestigationStatus @default(running)
  report       String?
  error        String?
  startedAt    DateTime            @default(now()) @map("started_at")
  finishedAt   DateTime?           @map("finished_at")
  messages     Message[]

  @@index([tenantId, incidentId])
  @@map("investigation")
}

model Usage {
  id                  String   @id @default(cuid())
  tenantId            String   @map("tenant_id")
  source              String   // "investigation" | "slack" | "web"
  investigationId     String?  @map("investigation_id")
  model               String
  effort              String?
  status              String   // done | failed, so failed turns still count
  modelCalls          Int      @map("model_calls")
  uncachedInputTokens Int      @map("uncached_input_tokens")
  cacheWriteTokens    Int      @map("cache_write_tokens")
  cacheReadTokens     Int      @map("cache_read_tokens")
  outputTokens        Int      @map("output_tokens")
  createdAt           DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@map("usage")
}

// seq is the message's position: 0 is the alert.
model Message {
  investigationId     String        @map("investigation_id")
  seq                 Int
  data                Json
  model               String?
  effort              String?
  uncachedInputTokens Int?          @map("uncached_input_tokens")
  cacheWriteTokens    Int?          @map("cache_write_tokens")
  cacheReadTokens     Int?          @map("cache_read_tokens")
  outputTokens        Int?          @map("output_tokens")
  createdAt           DateTime      @default(now()) @map("created_at")
  investigation       Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  @@id([investigationId, seq])
  @@map("message")
}

// Lowercase, so the API's status values stay as they are.
enum InvestigationStatus {
  running
  done
  failed
}
