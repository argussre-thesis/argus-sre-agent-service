{
  "name": "argus-agent-service",
  "version": "0.1.0",
  "private": true,
  "description": "Investigates incidents into RCA reports, using the runner's read-only ops as tools",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup-dev-db": "prisma migrate dev --name init && prisma generate",
    "setup-prod-db": "prisma migrate deploy && prisma generate",
    "update-dev-db": "prisma migrate dev --name update && prisma generate",
    "update-prod-db": "prisma migrate deploy",
    "dev-first": "prisma generate && npm run dev",
    "start": "node src/index.ts",
    "dev": "node --env-file-if-exists=.env src/index.ts",
    "investigate": "node --env-file-if-exists=.env dev/investigate.ts",
    "continue": "node --env-file-if-exists=.env dev/continue.ts",
    "eval": "node --env-file-if-exists=.env dev/eval.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@langchain/anthropic": "^1.5.12",
    "@langchain/core": "^1.2.18",
    "@langchain/openai": "^1.6.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "express": "^5.3.0",
    "langchain": "^1.5.18",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "prisma": "^7.10.0",
    "typescript": "^7.0.2"
  }
}
