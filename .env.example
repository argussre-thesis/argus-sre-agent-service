# Copy to .env and fill in. Empty values fall back to the defaults in src/config.ts.

# Model: "anthropic" (default) or "openai"
MODEL_PROVIDER=anthropic
MAX_MODEL_CALLS=30
# anthropic: low | medium | high | xhigh | max (default high)
# openai: none | minimal | low | medium | high | xhigh | max (optional, reasoning models only)
MODEL_EFFORT=high

# Anthropic Config (required when MODEL_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# OpenAI Config (required when MODEL_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Database Config
DATABASE_URL=postgresql://user:password@localhost:5432/argus

# Internal Config
# Tokens are at least 32 chars, e.g. `openssl rand -hex 32`.
# Must match the backend's token for this service.
BACKEND_AGENT_SERVICE_TOKEN=
# Must match the gateway's token for the agent.
AGENT_GATEWAY_TOKEN=
HOST=127.0.0.1
PORT=8090
GATEWAY_URL=http://127.0.0.1:8081
# The backend, told when an investigation ends.
BACKEND_URL=http://127.0.0.1:5000
# Local testing (dev/ scripts only)
DEV_TENANT_ID=
# AGENT_URL=http://127.0.0.1:8090
