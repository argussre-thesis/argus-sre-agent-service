# Copy to .env and fill in. Empty values fall back to the defaults in src/config.ts.

# Model: "anthropic" (default) or "openai"
MODEL_PROVIDER=anthropic
MAX_MODEL_CALLS=30

# Anthropic Config (required when MODEL_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
# Each request names a level (low when it names none); each level is a model and an effort.
# Effort: low | medium | high | xhigh | max
LOW_MODEL=claude-haiku-5-5
LOW_EFFORT=medium
MEDIUM_MODEL=claude-sonnet-5-5
MEDIUM_EFFORT=high
HIGH_MODEL=claude-opus-5-5
HIGH_EFFORT=high

# OpenAI Config (required when MODEL_PROVIDER=openai): one model for every level
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# none | minimal | low | medium | high | xhigh | max (optional, reasoning models only)
MODEL_EFFORT=

# Database Config
DATABASE_URL=postgresql://user:password@localhost:5432/argus

# Internal Config
# Tokens are at least 32 chars, e.g. `openssl rand -hex 32`.
# Must match the backend's token for this service.
BACKEND_AGENT_SERVICE_TOKEN=
# Must match the gateway's token for the agent.
AGENT_GATEWAY_TOKEN=
HOST=127.0.0.1
PORT=8090
GATEWAY_URL=http://127.0.0.1:8081
# The backend, told when an investigation ends.
BACKEND_URL=http://127.0.0.1:5000
# Local testing (dev/ scripts only)
DEV_TENANT_ID=
# The level dev/investigate.ts and dev/eval.ts ask for (default low)
DEV_LEVEL=
# AGENT_URL=http://127.0.0.1:8090
